# 내 컴퓨터에서 AI를 시험할 때: 이 파일을 복사해 .env.local로 만들고 키를 넣어요. (.env.local은 깃허브에 올라가지 않아요)
# 배포(Vercel)에서는 이 파일이 아니라 Vercel → Settings → Environment Variables에 넣어요.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# 커뮤니티 저장소(Upstash Redis). Vercel → Storage에서 연결하면 배포에는 자동으로 들어가요. 내 컴퓨터에서 실제 저장소를 쓸 때만 넣어요.
# 비워 두면 개발 서버는 메모리 저장소를 써요(껐다 켜면 글이 사라짐).
KV_REST_API_URL=
KV_REST_API_TOKEN=
